// Таблица-календарь (Представление таблицы -> Моделирование -> Создать таблицу).
// Вставьте целиком в строку формул и нажмите Enter.
// CALENDARAUTO берёт все даты модели (Order Date, Ship Date, Return Date)
// и строит непрерывный ряд полных лет: 01.01.2023 - 31.12.2027, 1826 дней.

Календарь =
ADDCOLUMNS(
    CALENDARAUTO(),
    "Год", YEAR([Date]),
    "Квартал", QUARTER([Date]),
    "Месяц", MONTH([Date]),
    "Название месяца", FORMAT([Date], "MMMM"),
    "День месяца", DAY([Date]),
    "День недели", WEEKDAY([Date], 2),
    "Выходной", WEEKDAY([Date], 2) >= 6
)
