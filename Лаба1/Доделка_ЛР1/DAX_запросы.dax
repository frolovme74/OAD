// =====================================================================
// ЛР1, Power BI. DAX-запросы для модели «звезда» (Lab1_Frolov.pbix)
// Каждый запрос вставляйте в отдельную вкладку представления запросов DAX
// (кнопка «+» внизу), затем «Выполнить». Имена вкладок: Запрос 1 ... Запрос 5.
// Запускать ПОСЛЕ того, как созданы таблицы измерений и связи (шаги 1-7 гайда).
// =====================================================================


// ---------------------------------------------------------------------
// Запрос 1 (исправленный старый). Средний срок пополнения запаса по регионам.
// Было: 'Superstore'[Region] -- после перехода на звезду этого столбца нет.
// Ожидаемо: Central 8.25 | East 14.625 | South 8.875 | West 13.727
// ---------------------------------------------------------------------
EVALUATE
SUMMARIZECOLUMNS(
    'Местоположение'[Region],
    "Average Restock Lead Time (Days)",
    AVERAGEX(
        'Superstore',
        RELATED('Suppliers'[Restock Lead Time])
    )
)
ORDER BY 'Местоположение'[Region]


// ---------------------------------------------------------------------
// Запрос 2. Проверка звезды: размеры таблиц и строки фактов без пары в измерении.
// Ожидаемо: 10194 | 804 | 1862 | 655 | 4 | 1826 | 0 | 0 | 0 | 0
// Ненулевое значение в «Без ...» = ключ в фактах, которого нет в измерении.
// ---------------------------------------------------------------------
EVALUATE
ROW(
    "Строк в фактах",      COUNTROWS('Superstore'),
    "Клиентов",            COUNTROWS('Клиент'),
    "Товаров",             COUNTROWS('Товар'),
    "Местоположений",      COUNTROWS('Местоположение'),
    "Способов доставки",   COUNTROWS('Способ доставки'),
    "Дней в календаре",    COUNTROWS('Календарь'),
    "Без клиента",         COUNTROWS(FILTER('Superstore', ISBLANK(RELATED('Клиент'[Customer Name])))) + 0,
    "Без товара",          COUNTROWS(FILTER('Superstore', ISBLANK(RELATED('Товар'[Product Name])))) + 0,
    "Без местоположения",  COUNTROWS(FILTER('Superstore', ISBLANK(RELATED('Местоположение'[City])))) + 0,
    "Без даты",            COUNTROWS(FILTER('Superstore', ISBLANK(RELATED('Календарь'[Год])))) + 0
)


// ---------------------------------------------------------------------
// Запрос 3. Продажи и прибыль в разрезе «сегмент клиента × категория товара».
// RELATED подтягивает атрибуты из двух разных измерений в строку факта.
// Ожидаемо 9 строк, например: Consumer / Technology -> 406 399.90 | 70 797.81 | 951
// ---------------------------------------------------------------------
EVALUATE
VAR SalesRows =
    ADDCOLUMNS(
        'Superstore',
        "Сегмент",   RELATED('Клиент'[Segment]),
        "Категория", RELATED('Товар'[Category])
    )
RETURN
    GROUPBY(
        SalesRows,
        [Сегмент],
        [Категория],
        "Продажи", SUMX(CURRENTGROUP(), 'Superstore'[Sales]),
        "Прибыль", SUMX(CURRENTGROUP(), 'Superstore'[Profit]),
        "Строк",   COUNTX(CURRENTGROUP(), 'Superstore'[Row ID])
    )
ORDER BY [Сегмент], [Категория]


// ---------------------------------------------------------------------
// Запрос 4. Возвращённые заказы: причина возврата × регион.
// Связи: Superstore -> Возвраты (по Order ID) и Superstore -> Местоположение.
// Ожидаемо 2 строки: Брак / West -> 4 | 85.22 | 25.20
//                    Не подошёл / South -> 1 | 828.84 | 0.00
// ---------------------------------------------------------------------
EVALUATE
VAR ReturnedRows =
    FILTER(
        'Superstore',
        RELATED('Возвраты'[Returned]) = TRUE()
    )
RETURN
    GROUPBY(
        ADDCOLUMNS(
            ReturnedRows,
            "Причина", RELATED('Возвраты'[Return Reason]),
            "Регион",  RELATED('Местоположение'[Region])
        ),
        [Причина],
        [Регион],
        "Позиций",         COUNTX(CURRENTGROUP(), 'Superstore'[Row ID]),
        "Сумма продаж",    SUMX(CURRENTGROUP(), 'Superstore'[Sales]),
        "Прибыль",         SUMX(CURRENTGROUP(), 'Superstore'[Profit])
    )
ORDER BY [Причина], [Регион]


// ---------------------------------------------------------------------
// Запрос 5. Поставщики: продано штук, выручка и затраты по себестоимости.
// Ожидаемо 10 строк, первая: Storage Solutions / Mexico -> 31 | 459.10 | 471.20
// ---------------------------------------------------------------------
EVALUATE
VAR SupplierRows =
    ADDCOLUMNS(
        FILTER(
            'Superstore',
            NOT ISBLANK(RELATED('Suppliers'[Supplier Name]))
        ),
        "Поставщик", RELATED('Suppliers'[Supplier Name]),
        "Страна",    RELATED('Suppliers'[Supplier Country]),
        "Затраты",   RELATED('Suppliers'[Unit Cost]) * 'Superstore'[Quantity]
    )
RETURN
    GROUPBY(
        SupplierRows,
        [Поставщик],
        [Страна],
        "Продано, шт.",                SUMX(CURRENTGROUP(), 'Superstore'[Quantity]),
        "Выручка",                     SUMX(CURRENTGROUP(), 'Superstore'[Sales]),
        "Затраты по себестоимости",    SUMX(CURRENTGROUP(), [Затраты])
    )
ORDER BY [Выручка] DESC
